# ---------------------------------------------------------------------------
# Maestro configuration. Copy this file to `.env` and fill in what you use.
# Nothing here is required for `maestro demo` (it runs fully offline).
# ---------------------------------------------------------------------------

# --- Supervisor (the "frontier" / expensive brain) ---
# Only needed when you run with `--supervisor anthropic`.
ANTHROPIC_API_KEY=sk-ant-...
MAESTRO_SUPERVISOR_MODEL=claude-opus-4-8

# --- Executor (the cheap / local muscle) ---
# Only needed when you run with `--executor ollama`.
OLLAMA_HOST=http://localhost:11434
MAESTRO_EXECUTOR_MODEL=qwen2.5-coder:7b

# --- Optional: any OpenAI-compatible endpoint (LM Studio, vLLM, OpenRouter) ---
# Usable for either role with `--supervisor openai` / `--executor openai`.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=not-needed

# --- Named cloud providers (each is just an OpenAI-compatible endpoint) ---
# Use them as --supervisor/--executor or in `race --models`, e.g. deepseek, gemini, openrouter.
DEEPSEEK_API_KEY=sk-...                 # https://platform.deepseek.com (cheap)
GEMINI_API_KEY=...                      # https://aistudio.google.com (free tier)
OPENROUTER_API_KEY=sk-or-...            # https://openrouter.ai (many free OSS models)
